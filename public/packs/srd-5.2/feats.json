  {
    "id": "srd-5.2:feat/savage-attacker",
    "name": "Savage Attacker",
    "category": "origin",
    "repeatable": false,
    "effectGroups": [
      {
        "name": "Savage Attacker",
        "description": "You’ve trained to deal particularly damaging strikes. Once per turn when you hit a target with a weapon, you can roll the weapon’s damage dice twice and use either roll against the target.",
        "effects": [
          {
            "type": "rerollDamage",
            "reroll": {
              "mode": "reroll",
              "dice": "all",
              "keep": "best",
              "frequency": "perTurn"
            }
          }
        ]
      }
    ],
    "tags": [
      "damage",
      "melee"
    ]
  },
  {
    "id": "srd-5.2:feat/skilled",
    "name": "Skilled",
    "category": "origin",
    "repeatable": true,
    "effectGroups": [
      {
        "name": "Skilled",
        "description": "You gain proficiency in any combination of three skills or tools of your choice.",
        "effects": [
          {
            "type": "grantProficiency",
            "target": "$choice:skilled-proficiencies"
          }
        ]
      }
    ],
    "choices": [
      {
        "id": "skilled-proficiencies",
        "prompt": "Choose three proficiencies in any combination of skills or tools of your choice.",
        "count": 3,
        "fromTypes": [
          "skill",
          "tool"
        ]
      }
    ],
    "tags": [
      "proficiency"
    ]
  },
  {
    "id": "srd-5.2:feat/ability-score-improvement",
    "name": "Ability Score Improvement",
