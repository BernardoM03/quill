        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ],
      "amount": 2,
      "maximum": "$derived:abilityScoreMax"
    },
    "effectGroups": [
      {
        "name": "Ability Score Increase",
        "description": "Increase one ability score of your choice by 2, or increase two ability scores of your choice by 1 each.",
        "effects": []
      }
    ],
    "tags": [
      "progression"
    ]
  },
  {
    "id": "srd-5.2:feat/grappler",
    "name": "Grappler",
    "category": "general",
    "prerequisites": [
      {
        "type": "level",
        "minimum": 4
      },
      {
        "type": "any",
        "of": [
          {
            "type": "ability",
            "ability": "STR",
            "minimum": 13
          },
          {
            "type": "ability",
            "ability": "DEX",
            "minimum": 13
          }
        ]
      }
    ],
    "repeatable": false,
    "abilityScoreIncrease": {
      "from": [
        "STR",
        "DEX"
      ],
      "amount": 1,
      "maximum": "$derived:abilityScoreMax"
    },
    "effectGroups": [
      {
        "name": "Ability Score Increase",
        "description": "Increase your Strength or Dexterity score by 1, to a maximum of 20.",
        "effects": []
      },
      {
        "name": "Punch and Grab",
        "description": "When you hit a creature with an Unarmed Strike as part of the Attack action on your turn, you can use both the Damage and the Grapple option. You can use this benefit only once per turn.",
        "effects": []
      },
      {
        "name": "Attack Advantage",
        "description": "You have advantage on attack rolls against a creature Grappled by you",
        "effects": [
          {
            "type": "grantAdvantage",
            "target": "attackRoll",
            "affects": "self",
            "qualifiers": [
              {
                "type": "targetCondition",
                "conditionId": "srd-5.2:condition/grappled",
                "source": "self"
              }
            ]
          }
        ]
      }
    ],
    "tags": [
      "martial",
      "progression"
    ]
  },
  {
    "id": "srd-5.2:feat/archery",
    "name": "Archery",
    "category": "fightingStyle",
    "repeatable": false,
    "effectGroups": [
      {
        "name": "Archery",
        "description": "You gain a +2 bonus to attack rolls you make with ranged weapons",
        "effects": [
          {
            "type": "rollBonus",
            "target": "attackRoll",
            "value": 2,
            "qualifiers": [
              {
                "type": "attackRange",
                "attackRange": "ranged"
              },
              {
                "type": "attackSource",
                "attackSources": [
                  "weapon"
                ]
              }
            ]
          }
        ]
      }
    ],
    "tags": [
      "fightingStyle"
    ]
  },
  {
    "id": "srd-5.2:feat/defense",
    "name": "Defense",
    "category": "fightingStyle",
    "repeatable": false,
    "effectGroups": [
      {
        "name": "Defense",
        "description": "While you're wearing Light, Medium, or Heavy armor, you gain a +1 bonus to Armor Class",
        "effects": [
          {
            "type": "modifier",
            "target": "armorClass",
            "value": 1,
            "qualifiers": [
              {
                "type": "equipment",
                "equipment": "armor"
              }
            ]
          }
        ]
      }
    ],
    "tags": [
      "fightingStyle"
    ]
  },
  {
    "id": "srd-5.2:feat/great-weapon-fighting",
    "name": "Great Weapon Fighting",
    "category": "fightingStyle",
    "repeatable": false,
    "effectGroups": [
      {
        "name": "Great Weapon Fighting",
        "description": "When you roll damage for an attack you make with a Melee weapon that you are holding with two hands, you can treat any 1 or 2 on a damage die as a 3. The weapon must have the Two-Handed or Versatile property to gain this benefit.",
        "effects": [
          {
            "type": "rerollDamage",
            "qualifiers": [
              {
                "type": "attackRange",
                "attackRange": "melee"
              },
              {
                "type": "attackSource",
                "attackSources": [
                  "weapon"
                ]
              },
              {
                "type": "weaponProperty",
                "weaponProperties": [
                  "twoHanded",
                  "versatile"
                ]
              }
            ],
            "reroll": {
              "mode": "minimum",
              "triggerValues": [
                1,
                2
              ],
              "minimum": 3
            }
          }
        ]
      }
    ],
    "tags": [
      "fightingStyle"
    ]
  },
  {
    "id": "srd-5.2:feat/two-weapon-fighting",
    "name": "Two-Weapon Fighting",
    "category": "fightingStyle",
    "repeatable": false,
    "effectGroups": [
      {
        "name": "Two-Weapon Fighting",
        "description": "When you make an extra attack as a result of using a weapon that has the Light property, you can add your ability modifier to the damage of that attack if you aren’t already adding it to the damage.",
        "effects": [
          {
            "type": "rollBonus",
            "target": "damageRoll",
            "value": "$derived:abilityModifier",
            "qualifiers": [
              {
                "type": "weaponProperty",
                "weaponProperties": [
                  "light"
                ]
              }
            ]
          }
        ]
      }
    ],
    "tags": [
      "fightingStyle"
    ]
  },
  {
    "id": "srd-5.2:feat/boon-of-combat-prowess",
    "name": "Boon of Combat Prowess",
    "category": "epicBoon",
    "prerequisites": [
      {
        "type": "level",
        "minimum": 19
      }
    ],
    "repeatable": false,
    "abilityScoreIncrease": {
      "from": [
        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ],
      "amount": 1,
      "maximum": 30
    },
    "effectGroups": [
      {
        "name": "Ability Score Increase",
        "description": "Increase one ability score of your choice by 1, to a maximum of 30.",
        "effects": []
      },
      {
        "name": "Peerless Aim",
        "description": "When you miss with an attack roll, you can hit instead. Once you use this benefit, you can't use it again until the start of your next turn.",
        "effects": [
          {
            "type": "autoSucceed",
            "target": "attackRoll",
            "frequency": "perRound",
            "trigger": {
              "event": "failRoll",
              "roll": "attackRoll",
              "optional": true
            }
          }
        ]
      }
    ],
    "tags": [
      "epicBoon",
      "attack"
    ]
  },
  {
    "id": "srd-5.2:feat/boon-of-dimensional-travel",
    "name": "Boon of Dimensional Travel",
    "category": "epicBoon",
    "prerequisites": [
      {
        "type": "level",
        "minimum": 19
      }
    ],
    "repeatable": false,
    "abilityScoreIncrease": {
      "from": [
        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ],
      "amount": 1,
      "maximum": 30
    },
    "effectGroups": [
      {
        "name": "Ability Score Increase",
        "description": "Increase one ability score of your choice by 1, to a maximum of 30.",
        "effects": []
      },
      {
        "name": "Blink Steps",
        "description": "Immediately after you take the Attack action or the Magic action, you can teleport up to 30 feet to an unoccupied space you can see.",
        "effects": [
          {
            "type": "teleport",
            "value": 30,
            "trigger": [
