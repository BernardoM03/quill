[
  {
    "id": "srd-5.2:feat/alert",
    "name": "Alert",
    "category": "origin",
    "repeatable": false,
    "effectGroups": [
      {
        "name": "Initiative Proficiency",
        "description": "When you roll Initiative, you can add your Proficiency Bonus to the roll",
        "effects": [
          {
            "type": "rollBonus",
            "target": "initiative",
            "value": "$derived:proficiencyBonus"
          }
        ]
      },
      {
        "name": "Initiative Swap",
        "description": "Immediately after you roll Initiative, you can swap your Initiative with the Initiative of one willing ally in the same combat. You can’t make this swap if you or the ally has the Incapacitaed condition.",
        "effects": [
          {
            "type": "initiativeSwap"
          }
        ]
      }
    ],
    "tags": [
      "origin-feat"
    ]
  },
  {
    "id": "srd-5.2:feat/magic-initiate-cleric",
    "name": "Magic Initiate (Cleric)",
    "category": "origin",
    "repeatable": false,
    "effectGroups": [
      {
        "name": "Two Cantrips",
        "description": "You learn two cantrips of your choice from the Cleric spell list. Intelligence, Wisdomm, or Charisma is your spellcasting ability for this feat's spells (choose when you select this feat)",
        "effects": [
          {
            "type": "grantSpells",
            "target": "$choice:magic-initiate-cleric-cantrips"
          },
          {
            "type": "setSpellcastingAbility",
            "value": "$choice:magic-initiate-cleric-ability"
          }
        ]
      },
      {
        "name": "Level 1 Spell",
        "description": "Choose one level 1 spell from the Cleric spell list. You always have that spell prepared. You can cast it once without a spell slot, and you regain the ability to cast it in that way when you finish a Long Rest. You can also cast the spell using any spell slots you have.",
        "effects": [
          {
            "type": "grantSpells",
            "target": "$choice:magic-initiate-cleric-level-1-spell",
            "castingOverrides": {
              "alwaysPrepared": true,
              "freeCasts": {
                "count": 1,
                "recharge": "long"
              }
            }
          }
        ]
      },
      {
        "name": "Spell Change",
        "description": "Whenever you gain a new level, you can replace one of the spells you chose for this feat with a different spell of the same level from the Cleric spell list."
      }
    ],
    "choices": [
      {
        "id": "magic-initiate-cleric-ability",
        "prompt": "Choose your spellcasting ability for this feat's spells.",
        "count": 1,
        "from": [
          "INT",
          "WIS",
          "CHA"
        ]
      },
      {
        "id": "magic-initiate-cleric-cantrips",
        "prompt": "Choose two cantrips from the Cleric spell list.",
        "count": 2,
        "from": "srd-5.2:class/cleric",
        "qualifiers": [
          {
            "type": "spellLevel",
            "spellLevels": [
              0
            ]
          }
        ]
      },
      {
        "id": "magic-initiate-cleric-level-1-spell",
        "prompt": "Choose one level 1 spell from the Cleric spell list.",
        "count": 1,
        "from": "srd-5.2:class/cleric",
        "qualifiers": [
          {
            "type": "spellLevel",
            "spellLevels": [
              1
            ]
          }
        ]
      }
    ],
    "tags": [
      "spellcasting",
      "origin-feat"
    ]
  },
