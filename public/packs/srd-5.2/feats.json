  {
    "id": "srd-5.2:feat/boon-of-fate",
    "name": "Boon of Fate",
    "category": "epicBoon",
    "prerequisites": [
      {
        "type": "level",
        "minimum": 19
      }
    ],
    "repeatable": false,
    "abilityScoreIncrease": {
      "from": [
        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ],
      "amount": 1,
      "maximum": 30
    },
    "uses": {
      "max": 1,
      "recharge": "short"
    },
    "effectGroups": [
      {
        "name": "Ability Score Increase",
        "description": "Increase one ability score of your choice by 1, to a maximum of 30.",
        "effects": []
      },
      {
        "name": "Improve Fate",
        "description": "When you or another creature within 60 feet of you succeeds on or fails a D20 Test, you can roll 2d4 and apply the total rolled as a bonus or penalty to the d20 roll. Once you use this benefit, you can't use it again until you roll Initiative or finish a Short or Long Rest.",
        "effects": [
          {
            "type": "rollBonus",
            "target": "d20Test",
            "value": {
              "count": 2,
              "die": "d4"
            },
            "affects": "target",
            "appliesOnce": true,
            "qualifiers": [
              {
                "type": "range",
                "within": 60,
                "unit": "feet"
              }
            ]
          },
          {
            "type": "rollBonus",
            "target": "d20Test",
            "value": {
              "count": 2,
              "die": "d4"
            },
            "multiplier": -1,
            "affects": "target",
            "appliesOnce": true,
            "qualifiers": [
              {
                "type": "range",
                "within": 60,
                "unit": "feet"
              }
            ]
          },
          {
            "type": "restoreUses",
            "target": "srd-5.2:feat/boon-of-fate",
            "value": "all",
            "trigger": {
              "event": "rollInitiative"
            }
          }
        ]
      }
    ],
    "tags": [
      "epicBoon",
      "luck"
    ]
  },
  {
    "id": "srd-5.2:feat/boon-of-irresistible-offense",
    "name": "Boon of Irresistible Offense",
    "category": "epicBoon",
    "prerequisites": [
      {
        "type": "level",
        "minimum": 19
      }
    ],
    "repeatable": false,
    "abilityScoreIncrease": {
      "from": [
        "STR",
        "DEX"
      ],
      "amount": 1,
      "maximum": 30
    },
    "effectGroups": [
      {
        "name": "Ability Score Increase",
        "description": "Increase your Strength or Dexterity score by 1, to a maximum of 30.",
        "effects": []
      },
      {
        "name": "Overcome Defenses",
        "description": "The Bludgeoning, Piercing, and Slashing damage you deal always ignores Resistance.",
        "effects": [
          {
            "type": "ignoreResistance",
            "target": [
              "bludgeoning",
              "piercing",
              "slashing"
            ]
          }
        ]
      },
      {
        "name": "Overwhelming Strike",
        "description": "When you roll a 20 on the d20 for an attack roll, you can deal extra damage to the target equal to the ability score increased by this feat. The extra damage's type is the same as the attack's type.",
        "effects": [
          {
            "type": "dealDamage",
            "target": "$derived:attackDamageType",
            "value": "$derived:boonAbilityScore",
            "trigger": {
              "event": "criticalHit",
              "roll": "attackRoll",
              "optional": true
            }
          }
        ]
      }
    ],
    "tags": [
      "epicBoon",
      "damage"
    ]
  },
  {
