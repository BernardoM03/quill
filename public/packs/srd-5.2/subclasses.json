              }
            ]
          },
          {
            "type": "setBaseAc",
            "value": {
              "base": 10,
              "abilities": [
                "DEX",
                "CHA"
              ]
            },
            "qualifiers": [
              {
                "type": "equipment",
                "equipment": "armor",
                "negate": true
              }
            ]
          }
        ]
      },
      {
        "id": "srd-5.2:feature/draconic-sorcery-elemental-affinity",
        "name": "Elemental Affinity",
        "level": 6,
        "sourceId": "srd-5.2:subclass/draconic-sorcery",
        "description": "Choose one of the following damage types: Acid, Cold, Fire, Lightning, or Poison. You have Resistance to that damage type, and when you cast a Sorcerer spell that deals damage of that type, you can add your Charisma modifier to one damage roll of that spell.",
        "shortDescription": "Resistance to a chosen damage type, and add CHA to one damage roll of that type.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "defense",
          "damage"
        ],
        "choices": [
          {
            "id": "elemental-affinity-damage-type",
            "prompt": "Choose a damage type.",
            "count": 1,
            "from": [
              "acid",
              "cold",
              "fire",
              "lightning",
              "poison"
            ]
          }
        ],
        "effects": [
          {
            "type": "grantResistance",
            "target": "$choice:elemental-affinity-damage-type"
          },
          {
            "type": "modifier",
            "target": "spellDamage",
            "value": "$derived:CHA",
            "qualifiers": [
              {
                "type": "spellSource",
                "classId": "srd-5.2:class/sorcerer"
              },
              {
                "type": "damageType",
                "damageType": "$choice:elemental-affinity-damage-type"
              }
            ],
            "appliesOnce": true
          }
        ]
      },
      {
        "id": "srd-5.2:feature/draconic-sorcery-dragon-wings",
        "name": "Dragon Wings",
        "level": 14,
        "sourceId": "srd-5.2:subclass/draconic-sorcery",
        "description": "As a Bonus Action, you can cause draconic wings to appear on your back. The wings last for 1 hour or until you dismiss them (no action required). For the duration, you have a Fly Speed equal to your Speed.\n\nOnce you use this feature, you can't use it again until you finish a Long Rest unless you spend 3 Sorcery Points to use it again.",
        "shortDescription": "Bonus Action: gain a Fly Speed equal to your Speed for 1 hour.",
        "activation": {
          "type": "bonusAction"
        },
        "uses": {
          "max": 1,
          "recharge": "long"
        },
        "duration": {
          "value": 1,
          "unit": "hour"
        },
        "concentration": false,
        "tags": [
          "movement"
        ],
        "effects": [
          {
            "type": "grantSpeed",
            "target": "fly",
            "value": "$derived:walkingSpeed",
            "qualifiers": [
              {
                "type": "selfState",
                "featureId": "srd-5.2:feature/draconic-sorcery-dragon-wings"
              }
            ]
          }
        ]
      },
      {
        "id": "srd-5.2:feature/draconic-sorcery-dragon-companion",
        "name": "Dragon Companion",
        "level": 18,
        "sourceId": "srd-5.2:subclass/draconic-sorcery",
        "description": "You can cast Summon Dragon without a Material component. You can also cast it once without a spell slot, and you regain the ability to cast it in this way when you finish a Long Rest.",
        "shortDescription": "Cast Summon Dragon without materials, and once per Long Rest without a slot.",
        "activation": {
          "type": "special"
        },
        "uses": {
          "max": 1,
          "recharge": "long"
        },
        "tags": [
          "spellcasting",
          "summoning"
        ],
        "effects": [
          {
            "type": "grantSpells",
            "target": "srd-5.2:spell/summon-dragon",
            "castingOverrides": {
              "ignoreMaterialComponent": true,
              "freeCasts": {
                "count": 1,
                "recharge": "long"
              }
            }
          }
        ]
      }
