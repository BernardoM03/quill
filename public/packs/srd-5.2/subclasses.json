[
  {
    "id": "srd-5.2:subclass/path-of-the-berserker",
    "classId": "srd-5.2:class/barbarian",
    "name": "Path of the Berserker",
    "flavor": "Channel Rage into Violent Fury",
    "description": "Barbarians who walk the Path of the Berserker direct their Rage primarily toward violence. Their path is one of untrammeled fury, and they thrill in the chaos of battle as they allow their Rage to seize and empower them.",
    "subclassFeatureLevels": [
      3,
      6,
      10,
      14
    ],
    "features": [
      {
        "id": "srd-5.2:feature/berserker-frenzy",
        "name": "Frenzy",
        "level": 3,
        "sourceId": "srd-5.2:subclass/path-of-the-berserker",
        "description": "If you use Reckless Attack while your Rage is active, you deal extra damage to the first target you hit on your turn with a Strength-based attack. To determine the extra damage, roll a number of d6s equal to your Rage Damage bonus, and add them together. The damage has the same type as the weapon or Unarmed Strike used for the attack.",
        "shortDescription": "While raging and reckless, your first Strength hit each turn deals extra d6s.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "attack"
        ],
        "effects": [
          {
            "type": "dealDamage",
            "target": "$derived:weaponDamageType",
            "value": {
              "count": "$column:rageDamage",
              "die": "d6"
            },
            "frequency": "perTurn",
            "trigger": {
              "event": "hitWithAttack"
            },
            "qualifiers": [
              {
                "type": "selfState",
                "featureId": "srd-5.2:feature/barbarian-rage"
              },
              {
                "type": "selfState",
                "featureId": "srd-5.2:feature/barbarian-reckless-attack"
              },
              {
                "type": "ability",
                "abilities": [
                  "STR"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "srd-5.2:feature/berserker-mindless-rage",
        "name": "Mindless Rage",
        "level": 6,
        "sourceId": "srd-5.2:subclass/path-of-the-berserker",
        "description": "You have Immunity to the Charmed and Frightened conditions while your Rage is active. If you're Charmed or Frightened when you enter your Rage, the condition ends on you.",
        "shortDescription": "Immune to Charmed and Frightened while raging.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "defense"
        ],
        "effects": [
          {
            "type": "grantImmunity",
            "target": "srd-5.2:condition/charmed",
            "qualifiers": [
              {
                "type": "selfState",
                "featureId": "srd-5.2:feature/barbarian-rage"
              }
            ]
          },
          {
            "type": "grantImmunity",
            "target": "srd-5.2:condition/frightened",
            "qualifiers": [
              {
                "type": "selfState",
                "featureId": "srd-5.2:feature/barbarian-rage"
              }
            ]
          },
          {
            "type": "endCondition",
            "target": [
              "srd-5.2:condition/charmed",
              "srd-5.2:condition/frightened"
            ],
            "trigger": {
              "event": "useFeature",
              "featureId": "srd-5.2:feature/barbarian-rage"
            }
          }
        ]
      },
      {
        "id": "srd-5.2:feature/berserker-retaliation",
        "name": "Retaliation",
        "level": 10,
        "sourceId": "srd-5.2:subclass/path-of-the-berserker",
        "description": "When you take damage from a creature that is within 5 feet of you, you can take a Reaction to make one melee attack against that creature, using a weapon or an Unarmed Strike.",
        "shortDescription": "Reaction: melee attack a creature within 5 feet that damages you.",
        "activation": {
          "type": "reaction",
          "trigger": "You take damage from a creature within 5 feet of you."
        },
        "tags": [
          "attack",
          "reaction"
        ],
        "effects": [
          {
            "type": "grantAttack",
            "value": 1,
            "trigger": {
              "event": "takeDamage"
            },
            "qualifiers": [
              {
                "type": "targetRelation",
                "relation": "triggerCreature"
              },
              {
                "type": "range",
                "within": 5,
                "unit": "feet"
              },
              {
                "type": "attackRange",
                "attackRange": "melee"
              },
              {
                "type": "attackSource",
                "attackSources": [
                  "weapon",
                  "unarmed"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "srd-5.2:feature/berserker-intimidating-presence",
        "name": "Intimidating Presence",
        "level": 14,
        "sourceId": "srd-5.2:subclass/path-of-the-berserker",
        "description": "As a Bonus Action, you can strike terror into others with your menacing presence and primal power. When you do so, each creature of your choice in a 30-foot Emanation originating from you must make a Wisdom saving throw (DC 8 plus your Strength modifier and Proficiency Bonus). On a failed save, a creature has the Frightened condition for 1 minute. At the end of each of the Frightened creature's turns, the creature repeats the save, ending the effect on itself on a success.\n\nOnce you use this feature, you can't use it again until you finish a Long Rest unless you expend a use of your Rage (no action required) to restore your use of it.",
        "shortDescription": "Bonus Action: frighten chosen creatures in a 30-foot Emanation.",
        "activation": {
          "type": "bonusAction"
        },
        "uses": {
          "max": 1,
          "recharge": "long",
          "alternativeCost": {
            "featureId": "srd-5.2:feature/barbarian-rage",
            "amount": 1
          }
        },
        "duration": {
          "value": 1,
          "unit": "minute"
        },
        "tags": [
          "control"
        ],
        "effects": [
          {
            "type": "applyCondition",
            "target": "srd-5.2:condition/frightened",
            "area": [
              {
                "shape": "emanation",
                "size": 30
              }
            ],
            "save": {
              "ability": "WIS",
              "dc": {
                "base": 8,
                "ability": "STR",
                "proficiency": true
              },
              "onSuccess": "negate",
              "repeat": {
                "event": "endTurn"
              }
            }
          }
        ]
      }
    ]
  },
  {
    "id": "srd-5.2:subclass/college-of-lore",
    "classId": "srd-5.2:class/bard",
    "name": "College of Lore"
  },
