    "features": [
      {
        "id": "srd-5.2:feature/sorcerer-spellcasting",
        "name": "Spellcasting",
        "level": 1,
        "sourceId": "srd-5.2:class/sorcerer",
        "description": "Drawing from your innate magic, you can cast spells. Charisma is your spellcasting ability for your Sorcerer spells. You can use an Arcane Focus as a Spellcasting Focus for your Sorcerer spells.",
        "shortDescription": "Cast Sorcerer spells using Charisma.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "spellcasting"
        ],
        "effects": []
      },
      {
        "id": "srd-5.2:feature/sorcerer-innate-sorcery",
        "name": "Innate Sorcery",
        "level": 1,
        "sourceId": "srd-5.2:class/sorcerer",
        "description": "An event in your past left an indelible mark on you, infusing you with simmering magic. As a Bonus Action, you can unleash that magic for 1 minute, during which you gain the following benefits:\n\n- The spell save DC of your Sorcerer spells increases by 1.\n- You have Advantage on the attack rolls of Sorcerer spells you cast.\n\nYou can use this feature twice, and you regain all expended uses of it when you finish a Long Rest.",
        "shortDescription": "Bonus Action: +1 spell save DC and Advantage on Sorcerer spell attacks for 1 minute.",
        "activation": {
          "type": "bonusAction"
        },
        "uses": {
          "max": 2,
          "recharge": "long"
        },
        "duration": {
          "value": 1,
          "unit": "minute"
        },
        "concentration": false,
        "supersedes": null,
        "tags": [
          "buff",
          "spellcasting"
        ],
        "effects": [
          {
            "type": "modifier",
            "target": "spellSaveDC",
            "value": 1,
            "qualifiers": [
              {
                "type": "spellSource",
                "sourceId": "srd-5.2:class/sorcerer"
              },
              {
                "type": "selfState",
                "featureId": "srd-5.2:feature/sorcerer-innate-sorcery"
              }
            ]
          },
          {
            "type": "grantAdvantage",
            "target": "attackRoll",
            "affects": "self",
            "qualifiers": [
              {
                "type": "spellSource",
                "sourceId": "srd-5.2:class/sorcerer"
              },
              {
                "type": "selfState",
                "featureId": "srd-5.2:feature/sorcerer-innate-sorcery"
              }
            ]
          }
        ]
      },
      {
        "id": "srd-5.2:feature/sorcerer-font-of-magic",
        "name": "Font of Magic",
        "level": 2,
        "sourceId": "srd-5.2:class/sorcerer",
        "description": "You can tap into the wellspring of magic within yourself. This wellspring is represented by Sorcery Points, which allow you to create a variety of magical effects.\n\nYou have 2 Sorcery Points, and you gain more as you reach higher levels. You can't have more Sorcery Points than the maximum for your level. You regain all expended Sorcery Points when you finish a Long Rest.\n\n**Converting Spell Slots to Sorcery Points.** You can expend a spell slot to gain a number of Sorcery Points equal to the slot's level (no action required).\n\n**Creating Spell Slots.** As a Bonus Action, you can transform unexpended Sorcery Points into one spell slot.",
        "shortDescription": "Gain Sorcery Points; convert them to and from spell slots.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "resource"
        ],
        "effects": []
      },
      {
        "id": "srd-5.2:feature/sorcerer-metamagic",
        "name": "Metamagic",
        "level": 2,
        "sourceId": "srd-5.2:class/sorcerer",
        "description": "You gain the ability to twist your spells to suit your needs. You gain two Metamagic options of your choice. You gain another one at Sorcerer levels 10 and 17.\n\nYou can use only one Metamagic option on a spell when you cast it unless otherwise noted in one of those options.",
        "shortDescription": "Alter your spells by spending Sorcery Points.",
        "activation": {
          "type": "special"
        },
        "choices": [
          {
            "id": "metamagic-options",
            "prompt": "Choose a Metamagic option.",
            "count": "$scaling",
            "from": "srd-5.2:list/metamagic-options"
          }
        ],
        "scaling": [
          {
            "level": 2,
            "value": 2
          },
          {
            "level": 10,
            "value": 3
          },
          {
            "level": 17,
            "value": 4
          }
        ],
        "tags": [
          "spellcasting"
        ],
        "effects": []
      },
      {
        "id": "srd-5.2:feature/sorcerer-subclass",
        "name": "Sorcerer Subclass",
        "level": 3,
        "sourceId": "srd-5.2:class/sorcerer",
        "description": "You gain a Sorcerer subclass of your choice. A subclass is a specialization that grants you features at certain Sorcerer levels. For the rest of your career, you gain each of your subclass's features that are of your Sorcerer level or lower.",
        "shortDescription": "Choose a Sorcerer subclass.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "subclass"
        ],
        "effects": []
      },
      {
        "id": "srd-5.2:feature/sorcerer-ability-score-improvement",
        "name": "Ability Score Improvement",
        "level": 4,
        "sourceId": "srd-5.2:class/sorcerer",
        "description": "You gain the Ability Score Improvement feat or another feat of your choice for which you qualify. You gain this feature again at Sorcerer levels 8, 12, and 16.",
        "shortDescription": "Take a feat, or increase ability scores.",
        "activation": {
          "type": "passive"
        },
        "choices": [
          {
            "id": "sorcerer-ability-score-improvement",
            "prompt": "Choose Ability Score Improvement or another feat you qualify for.",
            "count": 1,
            "fromTypes": [
              "feat"
            ],
            "qualifiers": [
              {
                "type": "featCategory",
                "featCategories": [
                  "origin"
                ],
                "negate": true
              }
            ]
          }
        ],
        "tags": [
          "progression"
        ],
        "effects": [
          {
            "type": "grantFeature",
            "target": "$choice:sorcerer-ability-score-improvement"
          }
        ]
      },
      {
        "id": "srd-5.2:feature/sorcerer-sorcerous-restoration",
        "name": "Sorcerous Restoration",
        "level": 5,
        "sourceId": "srd-5.2:class/sorcerer",
        "description": "When you finish a Short Rest, you can regain expended Sorcery Points, but no more than a number equal to half your Sorcerer level (round down). Once you use this feature, you can't do so again until you finish a Long Rest.",
        "shortDescription": "Regain Sorcery Points on a Short Rest, once per Long Rest.",
        "activation": {
          "type": "free"
        },
        "uses": {
          "max": 1,
          "recharge": "long"
        },
        "tags": [
          "resource",
          "recovery"
        ],
        "effects": []
      },
      {
        "id": "srd-5.2:feature/sorcerer-sorcery-incarnate",
        "name": "Sorcery Incarnate",
        "level": 7,
        "sourceId": "srd-5.2:class/sorcerer",
        "description": "If you have no uses of Innate Sorcery left, you can use it if you expend 2 Sorcery Points when you take the Bonus Action to activate it.\n\nIn addition, while your Innate Sorcery feature is active, you can use up to two of your Metamagic options on each spell you cast.",
        "shortDescription": "Fuel Innate Sorcery with Sorcery Points; use two Metamagic options per spell while it is active.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "spellcasting"
        ],
        "effects": []
      },
      {
        "id": "srd-5.2:feature/sorcerer-epic-boon",
        "name": "Epic Boon",
        "level": 19,
