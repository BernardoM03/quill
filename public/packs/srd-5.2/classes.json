          }
        ]
      },
      {
        "id": "srd-5.2:feature/fighter-studied-attacks",
        "name": "Studied Attacks",
        "level": 13,
        "sourceId": "srd-5.2:class/fighter",
        "description": "You study your opponents and learn from each attack you make. If you make an attack roll against a creature and miss, you have Advantage on your next attack roll against that creature before the end of your next turn.",
        "shortDescription": "After a miss, Advantage on your next attack against that creature.",
        "activation": {
          "type": "passive"
        },
        "duration": {
          "value": 1,
          "unit": "round"
        },
        "tags": [
          "attack"
        ],
        "effects": [
          {
            "type": "grantAdvantage",
            "target": "attackRoll",
            "appliesOnce": true,
            "qualifiers": [
              {
                "type": "targetRelation",
                "relation": "triggerCreature"
              }
            ],
            "trigger": {
              "event": "failRoll",
              "roll": "attackRoll"
            }
          }
        ]
      },
      {
