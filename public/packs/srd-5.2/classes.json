    "features": [
      {
        "id": "srd-5.2:feature/fighter-fighting-style",
        "name": "Fighting Style",
        "level": 1,
        "sourceId": "srd-5.2:class/fighter",
        "description": "You have honed your martial prowess and gain a Fighting Style feat of your choice (see \"Feats\"). Defense is recommended.\n\nWhenever you gain a Fighter level, you can replace the feat you chose with a different Fighting Style feat.",
        "shortDescription": "Gain a Fighting Style feat; swap it on any Fighter level.",
        "activation": {
          "type": "passive"
        },
        "choices": [
          {
            "id": "fighter-fighting-style",
            "count": 1,
            "fromTypes": [
              "feat"
            ],
            "qualifiers": [
              {
                "type": "featCategory",
                "featCategories": [
                  "fightingStyle"
                ]
              }
            ],
            "prompt": "Choose a Fighting Style feat.",
            "swap": {
              "trigger": {
                "event": "gainLevel"
              },
              "count": 1
            }
          }
        ],
        "tags": [
          "feat"
        ],
        "effects": [
          {
            "type": "grantFeature",
            "target": "$choice:fighter-fighting-style"
          }
        ]
      },
      {
        "id": "srd-5.2:feature/fighter-second-wind",
        "name": "Second Wind",
        "level": 1,
        "sourceId": "srd-5.2:class/fighter",
        "description": "You have a limited well of physical and mental stamina that you can draw on. As a Bonus Action, you can use it to regain Hit Points equal to 1d10 plus your Fighter level.\n\nYou can use this feature twice. You regain one expended use when you finish a Short Rest, and you regain all expended uses when you finish a Long Rest.\n\nWhen you reach certain Fighter levels, you gain more uses of this feature, as shown in the Second Wind column of the Fighter Features table.",
        "shortDescription": "Bonus Action: regain 1d10 + Fighter level HP.",
        "activation": {
          "type": "bonusAction"
        },
        "uses": {
          "max": "$scaling",
          "recharge": "long",
          "recover": {
            "rest": "short",
            "amount": 1
          }
        },
        "scaling": [
          {
            "level": 1,
            "value": 2
          },
          {
            "level": 4,
            "value": 3
          },
          {
            "level": 10,
            "value": 4
          }
        ],
        "tags": [
          "healing"
        ],
        "effects": [
          {
            "type": "heal",
            "value": {
              "count": 1,
              "die": "d10",
              "modifier": "$derived:classLevel"
            }
          }
        ]
      },
      {
        "id": "srd-5.2:feature/fighter-weapon-mastery",
        "name": "Weapon Mastery",
        "level": 1,
        "sourceId": "srd-5.2:class/fighter",
        "description": "Your training with weapons allows you to use the mastery properties of three kinds of Simple or Martial weapons of your choice. Whenever you finish a Long Rest, you can practice weapon drills and change one of those weapon choices.\n\nWhen you reach certain Fighter levels, you gain the ability to use the mastery properties of more kinds of weapons, as shown in the Weapon Mastery column of the Fighter Features table.",
        "shortDescription": "Use the mastery properties of 3 kinds of weapons (more at higher levels).",
        "activation": {
          "type": "passive"
        },
        "choices": [
          {
            "id": "fighter-weapon-mastery",
            "prompt": "Choose kinds of weapons whose mastery properties you can use.",
            "count": "$scaling",
            "fromTypes": [
              "equipment"
            ],
            "qualifiers": [
              {
                "type": "equipment",
                "equipment": "weapon"
              }
            ],
            "swap": {
              "trigger": {
                "event": "finishRest",
                "rest": "long"
              },
              "count": 1
            }
          }
        ],
        "scaling": [
          {
            "level": 1,
            "value": 3
          },
          {
            "level": 4,
            "value": 4
          },
          {
            "level": 10,
            "value": 5
          },
          {
            "level": 16,
            "value": 6
          }
        ],
        "tags": [
          "weaponMastery"
        ],
        "effects": [
          {
            "type": "grantMastery",
            "target": "$choice:fighter-weapon-mastery"
          }
        ]
      },
      {
        "id": "srd-5.2:feature/fighter-action-surge",
        "name": "Action Surge",
        "level": 2,
        "sourceId": "srd-5.2:class/fighter",
        "description": "You can push yourself beyond your normal limits for a moment. On your turn, you can take one additional action, except the Magic action.\n\nOnce you use this feature, you can't do so again until you finish a Short or Long Rest. Starting at level 17, you can use it twice before a rest but only once on a turn.",
        "shortDescription": "Take one additional action on your turn (not Magic).",
        "activation": {
          "type": "free"
        },
        "uses": {
          "max": "$scaling",
          "recharge": "short",
          "perTurn": 1
        },
        "scaling": [
          {
            "level": 2,
            "value": 1
          },
          {
            "level": 17,
            "value": 2
          }
        ],
        "tags": [
          "actionEconomy"
        ],
        "effects": [
          {
            "type": "extraAction",
            "value": "action",
            "qualifiers": [
              {
                "type": "namedAction",
                "actions": [
                  "magic"
                ],
                "negate": true
              }
            ]
          }
        ]
      },
      {
        "id": "srd-5.2:feature/fighter-tactical-mind",
        "name": "Tactical Mind",
        "level": 2,
        "sourceId": "srd-5.2:class/fighter",
        "description": "You have a mind for tactics on and off the battlefield. When you fail an ability check, you can expend a use of your Second Wind to push yourself toward success. Rather than regaining Hit Points, you roll 1d10 and add the number rolled to the ability check, potentially turning it into a success. If the check still fails, this use of Second Wind isn't expended.",
        "shortDescription": "After failing an ability check, spend a Second Wind use to add 1d10.",
        "activation": {
          "type": "free",
          "cost": {
            "featureId": "srd-5.2:feature/fighter-second-wind",
            "amount": 1,
            "refundOnFailure": true
          }
        },
        "tags": [
          "skill"
        ],
        "effects": [
          {
            "type": "rollBonus",
            "target": "abilityCheck",
            "value": {
              "count": 1,
              "die": "d10"
            },
            "appliesOnce": true,
            "trigger": {
              "event": "failRoll",
              "roll": "abilityCheck",
              "optional": true
            }
          }
        ]
      },
      {
        "id": "srd-5.2:feature/fighter-subclass",
        "name": "Fighter Subclass",
        "level": 3,
        "sourceId": "srd-5.2:class/fighter",
        "description": "You gain a Fighter subclass of your choice. The Champion subclass is detailed after this class's description. A subclass is a specialization that grants you features at certain Fighter levels. For the rest of your career, you gain each of your subclass's features that are of your Fighter level or lower.",
        "shortDescription": "Choose a Fighter subclass.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "subclass"
        ],
        "effects": []
      },
      {
        "id": "srd-5.2:feature/fighter-ability-score-improvement",
        "name": "Ability Score Improvement",
        "level": 4,
        "sourceId": "srd-5.2:class/fighter",
        "description": "You gain the Ability Score Improvement feat (see \"Feats\") or another feat of your choice for which you qualify. You gain this feature again at Fighter levels 6, 8, 12, 14, and 16.",
        "shortDescription": "Take a feat, or increase ability scores.",
        "activation": {
          "type": "passive"
        },
        "choices": [
          {
            "id": "fighter-ability-score-improvement",
            "count": 1,
            "fromTypes": [
              "feat"
            ],
            "qualifiers": [
              {
                "type": "featCategory",
                "featCategories": [
                  "origin"
                ],
                "negate": true
              }
            ],
            "prompt": "Choose Ability Score Improvement or another feat you qualify for."
          }
        ],
        "tags": [
          "progression"
        ],
        "effects": [
          {
            "type": "grantFeature",
            "target": "$choice:fighter-ability-score-improvement"
          }
        ]
      },
      {
        "id": "srd-5.2:feature/fighter-extra-attack",
        "name": "Extra Attack",
        "level": 5,
        "sourceId": "srd-5.2:class/fighter",
        "description": "You can attack twice instead of once whenever you take the Attack action on your turn.",
        "shortDescription": "Attack twice with the Attack action.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "attack"
        ],
        "effects": [
          {
            "type": "setAttackCount",
            "value": 2
          }
        ]
      },
      {
        "id": "srd-5.2:feature/fighter-tactical-shift",
        "name": "Tactical Shift",
        "level": 5,
        "sourceId": "srd-5.2:class/fighter",
        "description": "Whenever you activate your Second Wind with a Bonus Action, you can move up to half your Speed without provoking Opportunity Attacks.",
        "shortDescription": "Move half your Speed without provoking when you use Second Wind.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "movement"
        ],
        "effects": [
          {
            "type": "grantMovement",
            "value": {
              "speedFraction": 0.5,
              "provokesOpportunityAttacks": false
            },
            "trigger": {
              "event": "useFeature",
              "featureId": "srd-5.2:feature/fighter-second-wind",
              "optional": true
            }
          }
        ]
      },
      {
        "id": "srd-5.2:feature/fighter-indomitable",
        "name": "Indomitable",
        "level": 9,
        "sourceId": "srd-5.2:class/fighter",
        "description": "If you fail a saving throw, you can reroll it with a bonus equal to your Fighter level. You must use the new roll, and you can't use this feature again until you finish a Long Rest.\n\nYou can use this feature twice before a Long Rest starting at level 13 and three times before a Long Rest starting at level 17.",
        "shortDescription": "Reroll a failed save with a bonus equal to your Fighter level.",
        "activation": {
          "type": "free"
        },
        "uses": {
          "max": "$scaling",
          "recharge": "long"
        },
        "scaling": [
          {
            "level": 9,
            "value": 1
          },
          {
            "level": 13,
            "value": 2
          },
          {
            "level": 17,
            "value": 3
          }
        ],
        "tags": [
          "defense"
        ],
        "effects": [
          {
            "type": "rerollD20",
            "target": "savingThrow",
            "reroll": {
              "mode": "reroll",
              "dice": 1,
              "keep": "new",
              "bonus": "$derived:classLevel"
            },
            "trigger": {
              "event": "failRoll",
              "roll": "savingThrow",
              "optional": true
            }
          }
        ]
      },
      {
        "id": "srd-5.2:feature/fighter-tactical-master",
        "name": "Tactical Master",
        "level": 9,
        "sourceId": "srd-5.2:class/fighter",
        "description": "When you attack with a weapon whose mastery property you can use, you can replace that property with the Push, Sap, or Slow property for that attack.",
        "shortDescription": "Swap a weapon's mastery for Push, Sap, or Slow on an attack.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "weaponMastery"
        ],
        "effects": [
          {
            "type": "substituteMastery",
            "value": [
              "push",
              "sap",
              "slow"
            ]
          }
        ]
      },
      {
        "id": "srd-5.2:feature/fighter-two-extra-attacks",
        "name": "Two Extra Attacks",
        "level": 11,
        "sourceId": "srd-5.2:class/fighter",
        "description": "You can attack three times instead of once whenever you take the Attack action on your turn.",
        "shortDescription": "Attack three times with the Attack action.",
        "activation": {
          "type": "passive"
        },
        "supersedes": "srd-5.2:feature/fighter-extra-attack",
