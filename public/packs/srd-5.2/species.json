                  "die": "d10"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "srd-5.2:feature/dragonborn-damage-resistance",
        "name": "Damage Resistance",
        "sourceId": "srd-5.2:species/dragonborn",
        "description": "You have Resistance to the damage type determined by your Draconic Ancestry trait.",
        "shortDescription": "Resistance to your Draconic Ancestry damage type.",
        "activation": {
