      {
        "id": "srd-5.2:feature/dragonborn-darkvision",
        "name": "Darkvision",
        "sourceId": "srd-5.2:species/dragonborn",
        "description": "You have Darkvision with a range of 60 feet.",
        "shortDescription": "See in dim light and darkness within 60 feet.",
        "activation": {
          "type": "passive"
        },
        "tags": [
          "senses"
        ],
        "effects": [
          {
            "type": "grantSense",
            "target": "darkvision",
            "value": 60
          }
        ]
      },
      {
        "id": "srd-5.2:feature/dragonborn-draconic-flight",
        "name": "Draconic Flight",
        "level": 5,
        "sourceId": "srd-5.2:species/dragonborn",
        "description": "When you reach character level 5, you can channel draconic magic to give yourself temporary flight. As a Bonus Action, you sprout spectral wings on your back that last for 10 minutes or until you retract the wings (no action required) or have the Incapacitated condition. During that time, you have a Fly Speed equal to your Speed. Your wings appear to be made of the same energy as your Breath Weapon. Once you use this trait, you can't use it again until you finish a Long Rest.",
        "shortDescription": "Bonus Action: sprout wings and gain a Fly Speed equal to your Speed for 10 minutes.",
        "activation": {
          "type": "bonusAction"
        },
        "uses": {
          "max": 1,
          "recharge": "long"
        },
        "duration": {
          "value": 10,
          "unit": "minute"
        },
        "tags": [
          "movement"
        ],
        "effects": [
          {
            "type": "grantSpeed",
            "target": "fly",
            "value": "$derived:walkingSpeed",
            "qualifiers": [
              {
                "type": "selfState",
                "featureId": "srd-5.2:feature/dragonborn-draconic-flight"
              }
            ]
          }
        ]
      }
    ]
