      {
        "id": "srd-5.2:feature/dwarven-toughness",
        "name": "Dwarven Toughness",
        "sourceId": "srd-5.2:species/dwarf",
        "description": "Your Hit Point maximum increases by 1, and it increases by 1 again whenever you gain a level.",
