{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quill.local/schemas/species.schema.json",
  "title": "D&D 5.5e SRD Species",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "$ref": "https://quill.local/schemas/common.schema.json#/$defs/speciesId"
      },
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "creatureType": {
        "$ref" : "https://quill.local/schemas/common.schema.json#/$defs/creatureType"
      },
      "creatureSize": {
        "description": "Fixed for most species. A $choice: sentinel where the species lets the player pick, as Human does between Small and Medium - the size is then a build decision like any other, not a property of the species. Widened here rather than in the shared creatureSize enum, which other consumers still need to read strictly.",
        "oneOf": [
          {
            "$ref": "https://quill.local/schemas/common.schema.json#/$defs/creatureSize"
          },
          {
            "$ref": "https://quill.local/schemas/common.schema.json#/$defs/deferredValue"
          }
        ]
      },
      "speed": {
        "type": "integer"
      },
      "traits": {
        "type": "array",
        "items": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/feature"
        }
      }
    },
    "required": [
      "id",
      "name"
    ],
    "additionalProperties": false
  }
}
