{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quill.local/schemas/equipment.schema.json",
  "title": "D&D 5.5e SRD Equipment",
  "description": "Top-level array of mundane equipment: weapons, armor, adventuring gear, packs, mounts, tack, and vehicles. Tools live in tools.json. One schema with a `category` discriminator rather than one per kind, so starting equipment and pack contents point at a single id type. Each category's fields are required by an if/then pair and forbidden on every other category, so a Shield cannot carry weapon damage by mistake.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/item"
  },
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/equipmentId"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "weapon",
            "armor",
            "ammunition",
            "spellcastingFocus",
            "gear",
            "pack",
            "mount",
            "tack",
            "vehicle"
          ]
        },
        "cost": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/cost"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "Pounds. Omit where the table shows a dash or 'Varies'."
        },
        "description": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "https://quill.local/schemas/common.schema.json#/$defs/itemVariant"
          },
          "minItems": 1,
          "description": "Forms that differ in price or weight. An item with variants and no top-level cost is priced by the form the player picks."
        },
        "weaponCategory": {
          "type": "string",
          "enum": [
            "simple",
            "martial"
          ]
        },
        "attackRange": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/attackRange"
        },
        "damage": {
          "description": "Dice, or a flat number for the Blowgun's 1 damage.",
          "oneOf": [
            {
              "$ref": "https://quill.local/schemas/common.schema.json#/$defs/diceExpression"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "damageType": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/damageType"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "https://quill.local/schemas/common.schema.json#/$defs/weaponProperty"
          },
          "uniqueItems": true
        },
        "range": {
          "type": "object",
          "description": "Normal and long range in feet, from the Range property.",
          "properties": {
            "normal": {
              "type": "integer",
              "minimum": 0
            },
            "long": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "normal",
            "long"
          ],
          "additionalProperties": false
        },
        "versatileDamage": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/diceExpression"
        },
        "ammunition": {
          "allOf": [
            {
              "$ref": "https://quill.local/schemas/common.schema.json#/$defs/equipmentId"
            }
          ],
          "description": "The ammunition item this weapon fires."
        },
        "mastery": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/weaponMastery"
        },
        "armorCategory": {
          "allOf": [
            {
              "$ref": "https://quill.local/schemas/common.schema.json#/$defs/equipmentCategory"
            }
          ],
          "not": {
            "const": "armor"
          },
          "description": "lightArmor, mediumArmor, heavyArmor, or shield. Never the `armor` umbrella."
        },
        "baseArmorClass": {
          "allOf": [
            {
              "$ref": "https://quill.local/schemas/common.schema.json#/$defs/acFormula"
            }
          ],
          "description": "Base AC while worn. Heavy armor has an empty `abilities` list."
        },
        "acBonus": {
          "type": "integer",
          "description": "A Shield's bonus to AC."
        },
        "strength": {
          "type": "integer",
          "description": "Strength score below which the wearer's Speed drops by 10 feet."
        },
        "stealthDisadvantage": {
          "type": "boolean"
        },
        "donTime": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/duration"
        },
        "doffTime": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/duration"
        },
        "bundle": {
          "type": "integer",
          "minimum": 1,
          "description": "How many pieces one purchase buys."
        },
        "storage": {
          "allOf": [
            {
              "$ref": "https://quill.local/schemas/common.schema.json#/$defs/equipmentId"
            }
          ],
          "description": "The container this ammunition is usually kept in. Bought separately."
        },
        "focusType": {
          "type": "string",
          "enum": [
            "arcane",
            "druidic",
            "holy"
          ],
          "description": "Which classes' spellcasting can use it is the class's call, through its spellcasting focus."
        },
        "contents": {
          "type": "array",
          "items": {
            "$ref": "https://quill.local/schemas/common.schema.json#/$defs/equipmentGrant"
          },
          "minItems": 1
        },
        "carryingCapacity": {
          "type": "integer",
          "minimum": 0,
          "description": "Pounds."
        },
        "speedMph": {
          "type": "number",
          "minimum": 0
        },
        "crew": {
          "type": "integer",
          "minimum": 0
        },
        "passengers": {
          "type": "integer",
          "minimum": 0
        },
        "cargoTons": {
          "type": "number",
          "minimum": 0
        },
        "armorClass": {
          "type": "integer"
        },
        "hitPoints": {
          "type": "integer"
        },
        "damageThreshold": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "category"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "weapon"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "required": [
