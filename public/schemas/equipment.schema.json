{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quill.local/schemas/equipment.schema.json",
  "title": "D&D 5.5e SRD Equipment",
  "description": "Top-level array of mundane equipment: weapons, armor, adventuring gear, packs, mounts, tack, and vehicles. Tools live in tools.json. One schema with a `category` discriminator rather than one per kind, so starting equipment and pack contents point at a single id type. Each category's own fields live in a `<category>Fields` def that the matching if/then pulls in; `unevaluatedProperties: false` rejects any field no matching def declared, so a Shield cannot carry weapon damage by mistake.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/item"
  },
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/equipmentId"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "weapon",
            "armor",
            "ammunition",
            "spellcastingFocus",
            "gear",
            "pack",
            "mount",
            "tack",
            "vehicle"
          ]
        },
        "cost": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/cost"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "Pounds. Omit where the table shows a dash or 'Varies'."
        },
        "description": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "https://quill.local/schemas/common.schema.json#/$defs/itemVariant"
          },
          "minItems": 1,
          "description": "Forms that differ in price or weight. An item with variants and no top-level cost is priced by the form the player picks."
        },
        "activation": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/activation",
          "description": "What using the item costs, as Antitoxin's Bonus Action. Thrown flasks replace one attack of the Attack action, written as an action with a trigger note."
        },
        "uses": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/uses",
          "description": "Charges in the item, as a Healer's Kit's ten uses (recharge none)."
        },
        "effects": {
          "type": "array",
          "description": "The item's mechanics, in the shared effect vocabulary. A thrown flask's save DC is 8 plus the thrower's Dexterity modifier and Proficiency Bonus.",
          "items": {
            "$ref": "https://quill.local/schemas/common.schema.json#/$defs/effect"
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "https://quill.local/schemas/common.schema.json#/$defs/choice"
          },
          "description": "Decisions fixed when the item is made or bought, as the spell a Spell Scroll holds."
        }
      },
      "required": [
        "id",
        "name",
        "category"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "weapon"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "$ref": "#/$defs/weaponFields"
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "armor"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "$ref": "#/$defs/armorFields"
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "ammunition"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "$ref": "#/$defs/ammunitionFields"
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "spellcastingFocus"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "$ref": "#/$defs/spellcastingFocusFields"
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "gear"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "$ref": "#/$defs/gearFields"
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "pack"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "$ref": "#/$defs/packFields"
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "mount"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "$ref": "#/$defs/mountFields"
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "tack"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "$ref": "#/$defs/tackFields"
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "vehicle"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "$ref": "#/$defs/vehicleFields"
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "weaponFields": {
      "properties": {
        "weaponCategory": {
          "type": "string",
          "enum": [
            "simple",
            "martial"
          ]
        },
        "attackRange": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/attackRange"
        },
        "damage": {
          "description": "Dice, or a flat number for the Blowgun's 1 damage.",
          "oneOf": [
            {
              "$ref": "https://quill.local/schemas/common.schema.json#/$defs/diceExpression"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "damageType": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/damageType"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "https://quill.local/schemas/common.schema.json#/$defs/weaponProperty"
          },
          "uniqueItems": true
        },
        "range": {
          "type": "object",
          "description": "Normal and long range in feet, from the Range property.",
          "properties": {
            "normal": {
              "type": "integer",
              "minimum": 0
            },
            "long": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "normal",
            "long"
          ],
          "additionalProperties": false
        },
        "versatileDamage": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/diceExpression"
        },
        "ammunition": {
          "allOf": [
            {
              "$ref": "https://quill.local/schemas/common.schema.json#/$defs/equipmentId"
            }
          ],
          "description": "The ammunition item this weapon fires."
        },
        "mastery": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/weaponMastery"
        }
      },
      "required": [
        "weaponCategory",
        "attackRange",
        "damage",
        "damageType",
        "mastery"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "properties": {
                "contains": {
                  "const": "versatile"
                }
              }
            },
            "required": [
              "properties"
            ]
          },
          "then": {
            "required": [
              "versatileDamage"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "properties": {
                "contains": {
                  "const": "range"
                }
              }
            },
            "required": [
              "properties"
            ]
          },
          "then": {
            "required": [
              "range"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "properties": {
                "contains": {
                  "const": "ammunition"
                }
              }
            },
            "required": [
              "properties"
            ]
          },
          "then": {
            "required": [
              "ammunition"
            ]
          }
        }
      ]
    },
    "armorFields": {
      "properties": {
        "armorCategory": {
          "allOf": [
            {
              "$ref": "https://quill.local/schemas/common.schema.json#/$defs/equipmentCategory"
            }
          ],
          "not": {
            "const": "armor"
          },
          "description": "lightArmor, mediumArmor, heavyArmor, or shield. Never the `armor` umbrella."
        },
        "baseArmorClass": {
          "allOf": [
            {
              "$ref": "https://quill.local/schemas/common.schema.json#/$defs/acFormula"
            }
          ],
          "description": "Base AC while worn. Heavy armor has an empty `abilities` list."
        },
        "acBonus": {
          "type": "integer",
          "description": "A Shield's bonus to AC."
        },
        "strength": {
          "type": "integer",
          "description": "Strength score below which the wearer's Speed drops by 10 feet."
        },
        "stealthDisadvantage": {
          "type": "boolean"
        },
        "donTime": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/duration"
        },
        "doffTime": {
          "$ref": "https://quill.local/schemas/common.schema.json#/$defs/duration"
        }
      },
      "required": [
        "armorCategory"
      ],
      "if": {
        "properties": {
          "armorCategory": {
            "const": "shield"
          }
        },
        "required": [
          "armorCategory"
        ]
      },
      "then": {
        "required": [
          "acBonus"
        ],
        "not": {
          "required": [
            "baseArmorClass"
          ]
        }
      },
      "else": {
        "required": [
          "baseArmorClass"
        ],
        "not": {
          "required": [
            "acBonus"
          ]
        }
      }
    },
    "ammunitionFields": {
      "properties": {
        "bundle": {
          "type": "integer",
          "minimum": 1,
          "description": "How many pieces one purchase buys."
        },
        "storage": {
          "allOf": [
            {
              "$ref": "https://quill.local/schemas/common.schema.json#/$defs/equipmentId"
            }
          ],
          "description": "The container this ammunition is usually kept in. Bought separately."
        }
      },
      "required": [
        "bundle"
      ]
    },
    "spellcastingFocusFields": {
      "properties": {
        "focusType": {
          "type": "string",
          "enum": [
            "arcane",
            "druidic",
            "holy"
          ],
          "description": "Which classes' spellcasting can use it is the class's call, through its spellcasting focus."
        }
      },
      "required": [
        "focusType",
        "variants"
      ]
    },
    "gearFields": {
      "properties": {}
    },
    "packFields": {
      "properties": {
        "contents": {
          "type": "array",
          "items": {
            "$ref": "https://quill.local/schemas/common.schema.json#/$defs/equipmentGrant"
          },
          "minItems": 1
        }
      },
      "required": [
        "contents"
      ]
    },
    "mountFields": {
      "properties": {
        "carryingCapacity": {
          "type": "integer",
          "minimum": 0,
          "description": "Pounds."
        }
      },
      "required": [
        "carryingCapacity"
      ]
    },
    "tackFields": {
      "properties": {}
    },
    "vehicleFields": {
      "properties": {
        "speedMph": {
          "type": "number",
          "minimum": 0
        },
        "crew": {
          "type": "integer",
          "minimum": 0
        },
        "passengers": {
          "type": "integer",
          "minimum": 0
        },
        "cargoTons": {
          "type": "number",
          "minimum": 0
        },
        "armorClass": {
          "type": "integer"
        },
        "hitPoints": {
          "type": "integer"
        },
        "damageThreshold": {
          "type": "integer"
        }
      },
      "required": [
        "speedMph",
        "armorClass",
        "hitPoints"
      ]
    }
  }
}
