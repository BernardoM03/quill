# Copy to .env (git-ignored) and fill in. Read by compose.yaml.

# Where players reach Quill. Used for the first-run setup link and the allowed Host header.
QUILL_PUBLIC_URL=https://quill.al08.dev

# 1 once served over HTTPS (always the case through Cloudflare).
QUILL_SECURE_COOKIES=1

# The real visitor IP from Cloudflare, so rate limits are per player, not shared by all.
# Only safe because the app port is bound to 127.0.0.1 and the tunnel is the sole way in.
QUILL_CLIENT_IP_HEADER=CF-Connecting-IP

# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Install connector.
# Treat it like a password: anyone holding it can serve traffic for your hostname.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional. Left blank, a key is generated once into the data volume and kept there.
QUILL_SECRET_KEY=

# Host port for local access at http://127.0.0.1:8000.
QUILL_PORT=8000
